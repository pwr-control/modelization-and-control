# ============================================================
#  Notes on the syntax
# ============================================================
# - Comments must stand on their own line. Git has no inline
#   comments: "*.asv   # comment" is read as one literal pattern
#   and matches nothing.
# - Paths always use forward slashes, also on Windows. A
#   backslash escapes the next character, it is not a separator.
# - These rules apply to the whole tree. Files that are already
#   tracked stay tracked; remove them from the index with
#   "git rm --cached <file>".

# ============================================================
#  MATLAB / Simulink
# ============================================================

# Editor autosave and backup files
*.asv
*.m~
*.mlx~

# Simulink autosave, backup and old-release copies
# (model.slx.autosave, model.slx.bak, model.slx.r2023b, ...)
*.autosave
*.bak
*.r20*

# Simulink cache and build artifacts
*.slxc
slprj/
sccprj/
*_rtw/
codegen/
work/

# MEX binaries (mexw64, mexa64, mexmaci64, ...)
*.mex*

# Protected models
*.slxp
*.mdlp

# MATLAB Compiler / Coder outputs
html/
*.ctf
*.prj

# Machine-specific setup
pathdef.m
startup.m

# ============================================================
#  Data and figures
# ============================================================
# Simulation results and exported figures are regenerated by the
# scripts. The figures/ folders keep a .gitignore only so that
# the folder exists after a clone.

*.mat
*.eps
*.jpeg
*.jpg
*.png

# Measured data of long_cable_effects is versioned
!foundations_of_power_electronics/long_cable_effects/data/**/*.mat
!foundations_of_power_electronics/long_cable_effects/data/**/*.eps
!foundations_of_power_electronics/long_cable_effects/data/**/*.jpeg
!foundations_of_power_electronics/long_cable_effects/data/**/*.jpg
!foundations_of_power_electronics/long_cable_effects/data/**/*.png

