        if n_samples &lt; 1
            n_samples = 1;
        end
    
        % Aggiornamento sample_count: sample_count verrà aumentato, 
        % calato o mantenuto costante a seconda della differenza fra 
        % n_samples.
        if n_samples &gt; sample_count
            
            % Finestra aumenta → aggiungi nuovi campioni
            sum_short = sum_short + prev_input;
            sum_long  = sum_long  + input;
            
            sample_count = sample_count + 1;
    
        elseif n_samples &lt; sample_count
            
            % Finestra ridotta → rimuovi i campioni più vecchi
            oldest_sample_idx1 = buffer_index(cb_index, sample_count, MAVGFLT_SIZE_MAX);
            oldest_sample_idx2 = buffer_index(cb_index, sample_count - 1, MAVGFLT_SIZE_MAX);
            oldest_sample_1 = buffer(oldest_sample_idx1);
            oldest_sample_2 = buffer(oldest_sample_idx2);
            oldest_samples_sum = oldest_sample_1 + oldest_sample_2;
    
            sum_short = sum_short + prev_input - oldest_samples_sum;
            sum_long  = sum_long  + input - oldest_samples_sum;
    
            sample_count = sample_count - 1;
    
        else
            % Finestra costante
            oldest_sample = buffer_value(buffer, cb_index, sample_count, MAVGFLT_SIZE_MAX);
            sum_short = sum_short + prev_input - oldest_sample;
            sum_long  = sum_long  + input - oldest_sample;
        end
    
        % --- Aggiornamento buffer circolare ---
        buffer(cb_index) = input;
        cb_index = mod(cb_index, MAVGFLT_SIZE_MAX) + 1;
        prev_input = input;
    
        % --- Calcolo output ---
        if sample_count &gt; 1
            avg_short = sum_short / (sample_count - 1);
        else
            avg_short = 0;
        end
        avg_long = sum_long / sample_count;
    
        % Interpolazione lineare tra finestre
        output = avg_short * (1 - frac) + avg_long * frac;
    else
        output = 0;
    end
end


% funzioni gestion buffer circolare
function idx = buffer_index(cb_index, offset, max_size)
% Calcola indice 1-based di un campione &quot;offset&quot; passi indietro nel buffer
% circolare
    idx = mod(cb_index - 1 - offset, max_size) + 1;
end

function val = buffer_value(buffer, cb_index, offset, max_size)
% Restituisce il valore del buffer &quot;offset&quot; passi indietro
    idx = mod(cb_index - 1 - offset, max_size) + 1;
    val = buffer(idx);
end
