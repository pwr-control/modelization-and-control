        <P Name="script">function output = dmavgflt_process(input, period, ts, enable)
%#codegen
% DMAVGFLT_PROCESS  Dynamic Moving Average Filter con periodo variabile e frazionario
%
%   output = dmavgflt_process(input, period, ts)
%
%   Filtro a media mobile con:
%   - Buffer circolare
%   - Periodo variabile e frazionario
%   - Aggiornamento incrementale (alta efficienza)
%
%   Compatibile con Simulink (persistent variables)
%   ts (s) : sampling time
%   period (s) : periodo su cui si vuole fare la media
%   input : segnale da mediare.

    % Parametri fissi
    MAVGFLT_SIZE_MAX = 17500; % MAVGFLT_SIZE_MAX &gt; di 200ms/125us

    % Variabili persistenti (mantengono lo stato tra chiamate)
    persistent buffer cb_index sample_count sum_short sum_long prev_input

    % Inizializzazione al primo passo
    if isempty(buffer)
        buffer       = zeros(1, MAVGFLT_SIZE_MAX); %vettore del buffer circolare (1×MAVGFLT_SIZE_MAX)
        cb_index     = 1;   % current buffer index: indice di scrittura corrente
        sample_count = 1;   % sample count : numero di campioni attivi nella finestra, questo
                            % (e il suo sample_count-1) è il numero di
                            % campioni con cui farò la media.
                            % sample_count parte da zero e man mano cresce
                            % e viene aumentato e contratto a seconda del
                            % valore di n_samples.
        sum_short    = 0;   % somma corta
        sum_long     = 0;   % somma lunga
        prev_input   = 0;   % ultimo valore di ingresso 
    end

    if enable 
        % Gestione caso periodo nullo o negativo
        if period &lt;= 0
            output = 0;
            return;
        end
    
        % Numero desiderato di campioni: è un nemero reale
        desired_samples = period / ts;
    
        % Limite massimo
        if desired_samples &gt; (MAVGFLT_SIZE_MAX - 1)
            desired_samples = MAVGFLT_SIZE_MAX - 1;
        end
    
        % Parte intera e frazionaria
        % es: 
        % desired_samples = 20.8
        % n_samples = 21
        % frac = 0.8
        % desired_samples = 20.2
        % n_samples = 21
        % frac = 0.2

        % numero di campioni che coprono interamente il periodo
        n_samples = floor(desired_samples + 1); 
        % parte prazionaria 
        frac = desired_samples + 1 - n_samples; 
    
