<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[0, -7, 1536, 864]</P>
  <P Name="Open">on</P>
  <P Name="ReportName">simulink-default.rpt</P>
  <P Name="SIDHighWatermark">626</P>
  <Block BlockType="SubSystem" Name="three_phase_power_meter_iec" SID="1">
    <PortCounts in="4" out="1"/>
    <P Name="Position">[325, 131, 535, 314]</P>
    <P Name="ZOrder">8633</P>
    <P Name="HideAutomaticName">off</P>
    <P Name="LibrarySourceProduct" Ref="bdmxdata:LibrarySourceProduct_1"/>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Display RunInitForIconRedraw="off"/>
      <MaskParameter Name="period" Type="edit" ShowTooltip="off">
        <Prompt>period (s)</Prompt>
        <Value>pi/grid_emu.omega_grid_nom</Value>
      </MaskParameter>
      <MaskParameter Name="ts" Type="edit" ShowTooltip="off">
        <Prompt>sampling time (s)</Prompt>
        <Value>glb_time.ts_afe</Value>
      </MaskParameter>
      <MaskParameter Name="enable_time" Type="edit" ShowTooltip="off">
        <Prompt>enable_time (s)</Prompt>
        <Value>0.025</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Edit" Name="period">
          <Prompt>period (s)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="ts">
          <Prompt>sampling time (s)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="enable_time">
          <Prompt>enable_time (s)</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <System Ref="system_1"/>
  </Block>
</System>

