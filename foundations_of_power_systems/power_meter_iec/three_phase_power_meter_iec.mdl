<?xml version="1.0" encoding="utf-8"?>
<chart id="51">
  <P Name="name">three_phase_power_meter_iec/iabc_sin_cos/simple_moving_average_filter_5/dmavg_flt/dmavgflt_process</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">51</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">19</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">4</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">dmavgflt_process</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">51</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function output = dmavgflt_process(input, period, ts, enable)
%#codegen
% DMAVGFLT_PROCESS  Dynamic Moving Average Filter con periodo variabile e frazionario
%
%   output = dmavgflt_process(input, period, ts)
%
%   Filtro a media mobile con:
%   - Buffer circolare
%   - Periodo variabile e frazionario
%   - Aggiornamento incrementale (alta efficienza)
%
%   Compatibile con Simulink (persistent variables)
%   ts (s) : sampling time
%   period (s) : periodo su cui si vuole fare la media
%   input : segnale da mediare.

    % Parametri fissi
    MAVGFLT_SIZE_MAX = 17500; % MAVGFLT_SIZE_MAX &gt; di 200ms/125us

    % Variabili persistenti (mantengono lo stato tra chiamate)
    persistent buffer cb_index sample_count sum_short sum_long prev_input

    % Inizializzazione al primo passo
    if isempty(buffer)
        buffer       = zeros(1, MAVGFLT_SIZE_MAX); %vettore del buffer circolare (1×MAVGFLT_SIZE_MAX)
        cb_index     = 1;   % current buffer index: indice di scrittura corrente
        sample_count = 1;   % sample count : numero di campioni attivi nella finestra, questo
                            % (e il suo sample_count-1) è il numero di
                            % campioni con cui farò la media.
                            % sample_count parte da zero e man mano cresce
                            % e viene aumentato e contratto a seconda del
                            % valore di n_samples.
        sum_short    = 0;   % somma corta
        sum_long     = 0;   % somma lunga
        prev_input   = 0;   % ultimo valore di ingresso 
    end

    if enable 
        % Gestione caso periodo nullo o negativo
        if period &lt;= 0
            output = 0;
            return;
        end
    
        % Numero desiderato di campioni: è un nemero reale
        desired_samples = period / ts;
    
        % Limite massimo
        if desired_samples &gt; (MAVGFLT_SIZE_MAX - 1)
            desired_samples = MAVGFLT_SIZE_MAX - 1;
        end
    
        % Parte intera e frazionaria
        % es: 
        % desired_samples = 20.8
        % n_samples = 21
        % frac = 0.8
        % desired_samples = 20.2
        % n_samples = 21
        % frac = 0.2

        % numero di campioni che coprono interamente il periodo
        n_samples = floor(desired_samples + 1); 
        % parte prazionaria 
        frac = desired_samples + 1 - n_samples; 
    
        % Evita finestre vuote
        if n_samples &lt; 1
            n_samples = 1;
        end
    
        % Aggiornamento sample_count: sample_count verrà aumentato, 
        % calato o mantenuto costante a seconda della differenza fra 
        % n_samples.
        if n_samples &gt; sample_count
            
            % Finestra aumenta → aggiungi nuovi campioni
            sum_short = sum_short + prev_input;
            sum_long  = sum_long  + input;
            
            sample_count = sample_count + 1;
    
        elseif n_samples &lt; sample_count
            
            % Finestra ridotta → rimuovi i campioni più vecchi
            oldest_sample_idx1 = buffer_index(cb_index, sample_count, MAVGFLT_SIZE_MAX);
            oldest_sample_idx2 = buffer_index(cb_index, sample_count - 1, MAVGFLT_SIZE_MAX);
            oldest_sample_1 = buffer(oldest_sample_idx1);
            oldest_sample_2 = buffer(oldest_sample_idx2);
            oldest_samples_sum = oldest_sample_1 + oldest_sample_2;
    
            sum_short = sum_short + prev_input - oldest_samples_sum;
            sum_long  = sum_long  + input - oldest_samples_sum;
    
            sample_count = sample_count - 1;
    
        else
            % Finestra costante
            oldest_sample = buffer_value(buffer, cb_index, sample_count, MAVGFLT_SIZE_MAX);
            sum_short = sum_short + prev_input - oldest_sample;
            sum_long  = sum_long  + input - oldest_sample;
        end
    
        % --- Aggiornamento buffer circolare ---
        buffer(cb_index) = input;
        cb_index = mod(cb_index, MAVGFLT_SIZE_MAX) + 1;
        prev_input = input;
    
        % --- Calcolo output ---
        if sample_count &gt; 1
            avg_short = sum_short / (sample_count - 1);
        else
            avg_short = 0;
        end
        avg_long = sum_long / sample_count;
    
        % Interpolazione lineare tra finestre
        output = avg_short * (1 - frac) + avg_long * frac;
    else
        output = 0;
    end
end


% funzioni gestion buffer circolare
function idx = buffer_index(cb_index, offset, max_size)
% Calcola indice 1-based di un campione &quot;offset&quot; passi indietro nel buffer
% circolare
    idx = mod(cb_index - 1 - offset, max_size) + 1;
end

function val = buffer_value(buffer, cb_index, offset, max_size)
% Restituisce il valore del buffer &quot;offset&quot; passi indietro
    idx = mod(cb_index - 1 - offset, max_size) + 1;
    val = buffer(idx);
end
</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
